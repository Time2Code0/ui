          "50%": { "translate": "3px 0" }
        },
        "@keyframes toast-error-odd": {
          "0%, 100%": { "translate": "0 0" },
          "25%, 75%": { "translate": "-3px 0" },
          "50%": { "translate": "3px 0" }
        },
        "@keyframes toast-success-even": {
          "0%, 100%": { "scale": "1" },
          "30%": { "scale": "1.025" },
          "60%": { "scale": "0.99" }
        },
        "@keyframes toast-success-odd": {
          "0%, 100%": { "scale": "1" },
          "30%": { "scale": "1.025" },
          "60%": { "scale": "0.99" }
