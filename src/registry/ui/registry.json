    {
      "name": "alert",
      "type": "registry:ui",
      "title": "Alert",
      "description": "Alert and framed alert components for contextual feedback.",
      "cssVars": {
        "theme": {
          "animate-ribbon": "ribbon 1s linear infinite"
        }
      },
      "css": {
        "@keyframes ribbon": {
          "from": { "background-position": "0 0" },
          "to": {
            "background-position": "calc(var(--ribbon-stripe-size) * 2 * sqrt(2)) 0"
          }
        }
      },
      "dependencies": ["class-variance-authority", "cn"],
      "files": [{ "path": "alert.tsx", "type": "registry:ui" }]
    },
    {
      "name": "alert-dialog",
      "type": "registry:ui",
      "title": "Alert Dialog",
      "description": "An accessible modal alert dialog primitive.",
      "cssVars": {
        "theme": {
          "animate-shake": "shake 0.1s 2"
        }
      },
      "css": {
        "@keyframes shake": {
