    {
      "name": "animated-border",
      "type": "registry:component",
      "title": "Animated Border",
      "description": "Animated beam, shine, and gradient border primitives.",
      "cssVars": {
        "theme": {
          "animate-border-beam": "border-beam var(--duration) linear infinite",
          "animate-border-full": "border-full var(--duration) linear infinite",
          "animate-border-shiny": "border-shiny var(--duration) linear infinite"
        }
      },
      "css": {
        "@keyframes border-beam": {
          "100%": { "offset-distance": "100%" }
        },
        "@keyframes border-full": {
          "100%": { "background-position": "300% 0" }
        },
        "@keyframes border-shiny": {
          "0%, 100%": { "background-position": "0% 0%" },
          "50%": { "background-position": "100% 100%" }
        }
      },
      "dependencies": ["@base-ui/react", "cn"],
      "files": [
        {
          "path": "animated-border.tsx",
          "type": "registry:component",
          "target": "@components/marketing/animated-border.tsx"
        }
      ]
