import { exec } from "node:child_process";
import { writeFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";

import { loadRegistry } from "shadcn/registry";

const indexFile = fileURLToPath(
  new URL("../registry/__index__.tsx", import.meta.url)
);

async function run(command: string) {
  return await new Promise((resolve, reject) => {
    const process = exec(command);

    process.on("exit", (code) => {
      if (code === 0) {
        resolve(undefined);
      } else {
        reject(new Error(`Process exited with code ${code}`));
      }
    });
  });
}

const componentExtensionRegex = /\.(?:jsx|tsx)$/;
const identifierRegex = /^[A-Z_$][\w$]*$/i;

async function buildRegistryIndex() {
  const registry = await loadRegistry();
  const entries = registry.items
    .flatMap((item) => {
      const file =
        item.files?.find((candidate) => candidate.type === "registry:page") ??
        item.files?.find((candidate) =>
          componentExtensionRegex.test(candidate.path)
        );

      if (!file) {
        return [];
      }

      const filePath = file.path.replaceAll("\\", "/");

      if (!filePath.startsWith("src/")) {
        throw new Error(
          `Cannot create an aliased import for registry file "${file.path}".`
        );
      }

      const importPath = `@/${filePath
        .slice("src/".length)
        .replace(componentExtensionRegex, "")}`;

      return [{ importPath, name: item.name }];
    })
    .sort((left, right) => left.name.localeCompare(right.name));

  const indexEntries = entries
    .map(
      ({ importPath, name }) =>
        `  ${identifierRegex.test(name) ? name : JSON.stringify(name)}: lazy(async () => {
    const mod = await import(${JSON.stringify(importPath)});
    const exportName =
      Object.keys(mod).find(
        (key) => typeof mod[key] === "function" || typeof mod[key] === "object"
      ) || ${JSON.stringify(name)};
    return { default: mod.default || mod[exportName] };
  }),`
    )
    .join("\n");

  const source = `// @ts-nocheck
// This file is autogenerated by scripts/build-registry.mts
// Do not edit this file directly.
import "server-only";

import { lazy } from "react";

export const Index = {
${indexEntries}
} satisfies Record<
  string,
  React.LazyExoticComponent<React.ComponentType<unknown>>
>;
`;

  await writeFile(indexFile, source, "utf8");

  console.log(`#️⃣ ${entries.length} registry entries generated.`);
}

try {
  console.log("💅 Building registry...");
  await run("pnpm dlx shadcn build");

  console.log("🏗️ Building registry/__index__.tsx...");
  await buildRegistryIndex();
  await run(`pnpm fix ${JSON.stringify(indexFile)}`);

  console.log("✅ Registry build completed successfully!");
} catch (error) {
  console.error(error);
  process.exit(1);
}
