// Regenerates the particle index of the `time2code-particles` skill from the
// particle registries. Run it after adding, removing or renaming particles:
// `pnpm build:skills`.
import { readFile, writeFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";

interface RegistryItem {
  description?: string;
  name: string;
  registryDependencies?: string[];
  title?: string;
}

type Kind = "charts" | "hooks" | "marketing" | "ui";

const REGISTRY_URL = "https://ui.time2code.dev/r";

const registryDir = new URL("../registry/", import.meta.url);
const skillDir = new URL(
  "../../../skills/time2code-particles/",
  import.meta.url
);

const KINDS: { kind: Kind; label: string; title: string; intro: string }[] = [
  {
    intro:
      "Particles for the UI components in `@/components/ui`. Read the component's guide in the `time2code-ui` skill before adapting one.",
    kind: "ui",
    label: "UI component",
    title: "UI component particles",
  },
  {
    intro:
      "Particles for the charts in `@/components/charts`. Read the `time2code-charts` skill before adapting one.",
    kind: "charts",
    label: "chart",
    title: "Chart particles",
  },
  {
    intro:
      "Particles for the marketing components in `@/components/marketing` (text effects, backgrounds, cards and other landing-page pieces).",
    kind: "marketing",
    label: "marketing",
    title: "Marketing particles",
  },
  {
    intro: "Particles that demonstrate the hooks in `@/hooks`.",
    kind: "hooks",
    label: "hook",
    title: "Hook particles",
  },
];

const particleNameRegex = /^p-(.+)-(\d+)$/;
const placeholderDescriptionRegex = /^Demo component/;
const trailingPeriodRegex = /\.$/;
const generatedSectionRegex =
  /<!-- particles:start -->[\s\S]*<!-- particles:end -->/;

async function readItems(path: string): Promise<RegistryItem[]> {
  const json = JSON.parse(
    await readFile(new URL(path, registryDir), "utf8")
  ) as { items: RegistryItem[] };
  return json.items;
}

async function readNames(path: string): Promise<Set<string>> {
  return new Set((await readItems(path)).map((item) => item.name));
}

function parseName(name: string): { group: string; index: number } {
  const match = particleNameRegex.exec(name);
  if (!match) {
    throw new Error(`Unexpected particle name "${name}".`);
  }
  return { group: match[1], index: Number(match[2]) };
}

function describe(item: RegistryItem): string {
  const description = item.description?.trim();
  if (description && !placeholderDescriptionRegex.test(description)) {
    return description.replace(trailingPeriodRegex, "");
  }
  return item.title ?? item.name;
}

function renderKind(
  title: string,
  intro: string,
  groups: Map<string, RegistryItem[]>
): string {
  const total = [...groups.values()].reduce(
    (sum, items) => sum + items.length,
    0
  );
  const lines = [
    "<!-- Generated by `pnpm build:skills`. Do not edit by hand. -->",
    "",
    `# ${title}`,
    "",
    intro,
    "",
    `${total} particles. Each entry links to its registry JSON; the source is in \`files[].content\`.`,
    "",
  ];
  for (const [group, items] of groups) {
    lines.push(`## ${group}`, "");
    for (const item of items) {
      lines.push(
        `- \`${item.name}\`: ${describe(item)} ([JSON](${REGISTRY_URL}/${item.name}.json))`
      );
    }
    lines.push("");
  }
  return lines.join("\n");
}

function groupItems(items: RegistryItem[]): Map<string, RegistryItem[]> {
  const groups = new Map<string, RegistryItem[]>();
  const sorted = [...items].sort((left, right) => {
    const a = parseName(left.name);
    const b = parseName(right.name);
    return a.group.localeCompare(b.group) || a.index - b.index;
  });
  for (const item of sorted) {
    const { group } = parseName(item.name);
    groups.set(group, [...(groups.get(group) ?? []), item]);
  }
  return groups;
}

async function main() {
  const [uiNames, marketingNames, hookNames, particles, chartParticles] =
    await Promise.all([
      readNames("ui/registry.json"),
      readNames("marketing/registry.json"),
      readNames("hooks/registry.json"),
      readItems("particles/registry.json"),
      readItems("particles/charts/registry.json"),
    ]);

  const kindOf = (item: RegistryItem): Kind => {
    const { group } = parseName(item.name);
    if (uiNames.has(group)) {
      return "ui";
    }
    if (marketingNames.has(group)) {
      return "marketing";
    }
    if (hookNames.has(group)) {
      return "hooks";
    }
    // Composition particles (e.g. date-picker) are named after a pattern, not
    // an item; classify them by the components they install.
    const dependencies = (item.registryDependencies ?? []).map((dependency) =>
      dependency.replace("@time2code/", "")
    );
    if (dependencies.some((dependency) => marketingNames.has(dependency))) {
      return "marketing";
    }
    if (dependencies.some((dependency) => hookNames.has(dependency))) {
      return "hooks";
    }
    return "ui";
  };

  const byKind = new Map<Kind, RegistryItem[]>([
    ["charts", chartParticles],
    ["hooks", []],
    ["marketing", []],
    ["ui", []],
  ]);
  for (const item of particles) {
    byKind.get(kindOf(item))?.push(item);
  }

  const summary = await Promise.all(
    KINDS.map(async ({ intro, kind, label, title }) => {
      const items = byKind.get(kind) ?? [];
      const groups = groupItems(items);
      await writeFile(
        new URL(`references/${kind}.md`, skillDir),
        renderKind(title, intro, groups)
      );
      return `- [references/${kind}.md](references/${kind}.md): ${items.length} ${label} particles for ${groups.size} items: ${[...groups.keys()].join(", ")}`;
    })
  );

  const skillFile = new URL("SKILL.md", skillDir);
  const skill = await readFile(skillFile, "utf8");
  if (!generatedSectionRegex.test(skill)) {
    throw new Error("SKILL.md is missing the particles:start/end markers.");
  }
  await writeFile(
    skillFile,
    skill.replace(
      generatedSectionRegex,
      `<!-- particles:start -->\n${summary.join("\n")}\n<!-- particles:end -->`
    )
  );

  console.log(
    `Indexed ${particles.length + chartParticles.length} particles in ${fileURLToPath(skillDir)}`
  );
}

await main();
