    {
      "name": "chart-theme",
      "type": "registry:style",
      "title": "Chart Theme",
      "description": "Chart palette (--color-chart-1 … 5) and utilities shared by every chart.",
      "cssVars": {
        "light": {
          "chart-1": "oklch(0.585 0.233 277.117)",
          "chart-2": "oklch(0.852 0.199 91.936)",
          "chart-3": "oklch(0.667 0.295 322.15)",
          "chart-4": "oklch(0.56 0.021 213.5)",
          "chart-5": "oklch(0 0 0)"
        },
        "dark": {
          "chart-5": "oklch(1 0 0)"
        }
      },
      "css": {
        "@utility no-scrollbar": {
          "-ms-overflow-style": "none",
          "scrollbar-width": "none",
          "&::-webkit-scrollbar": {
            "display": "none"
          }
        }
      }
    },
